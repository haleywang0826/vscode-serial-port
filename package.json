{
  "name": "vscode-serial-port",
  "displayName": "Serial Port",
  "description": "Full-featured serial port tool for VS Code: monitor, send/receive (hex or ASCII), RTS/DTR control, multiple ports in parallel, log-to-file, and reusable send templates. Works transparently from WSL windows against physical Windows ports.",
  "version": "0.0.1",
  "publisher": "REPLACE_ME_PUBLISHER_ID",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/haleywang0826/vscode-serial-port"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "serial",
    "serial port",
    "com port",
    "uart",
    "embedded",
    "wsl"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serialPort",
          "title": "Serial Port",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "serialPort": [
        {
          "id": "serialPortExplorer",
          "name": "Ports"
        }
      ]
    },
    "commands": [
      {
        "command": "serialPort.selectPort",
        "title": "Serial Port: Select Port"
      },
      {
        "command": "serialPort.openSelectedPort",
        "title": "Serial Port: Open Selected Port",
        "icon": "$(plug)"
      },
      {
        "command": "serialPort.closeSession",
        "title": "Serial Port: Close Port",
        "icon": "$(debug-stop)"
      },
      {
        "command": "serialPort.alreadyOpenNoop",
        "title": "Serial Port: Already Open",
        "icon": "$(check)"
      },
      {
        "command": "serialPort.editDefaultSetting",
        "title": "Serial Port: Edit Default Setting"
      },
      {
        "command": "serialPort.editSessionSetting",
        "title": "Serial Port: Edit Session Setting"
      },
      {
        "command": "serialPort.addTemplate",
        "title": "Serial Port: Add Send Template",
        "icon": "$(add)"
      },
      {
        "command": "serialPort.editTemplate",
        "title": "Serial Port: Edit Template"
      },
      {
        "command": "serialPort.sendTemplate",
        "title": "Serial Port: Send Template",
        "icon": "$(send)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "serialPort.openSelectedPort",
          "when": "view == serialPortExplorer && viewItem == serialPort.portPicker",
          "group": "inline"
        },
        {
          "command": "serialPort.alreadyOpenNoop",
          "when": "view == serialPortExplorer && viewItem == serialPort.portPicker.open",
          "group": "inline"
        },
        {
          "command": "serialPort.closeSession",
          "when": "view == serialPortExplorer && viewItem == serialPort.session",
          "group": "inline"
        },
        {
          "command": "serialPort.addTemplate",
          "when": "view == serialPortExplorer && viewItem == serialPort.templatesRoot",
          "group": "inline"
        },
        {
          "command": "serialPort.sendTemplate",
          "when": "view == serialPortExplorer && viewItem == serialPort.templateRow",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "serialPort.closeSession",
          "when": "false"
        },
        {
          "command": "serialPort.alreadyOpenNoop",
          "when": "false"
        },
        {
          "command": "serialPort.editDefaultSetting",
          "when": "false"
        },
        {
          "command": "serialPort.editSessionSetting",
          "when": "false"
        },
        {
          "command": "serialPort.editTemplate",
          "when": "false"
        },
        {
          "command": "serialPort.sendTemplate",
          "when": "false"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "esbuild-watch",
        "source": "esbuild",
        "owner": "esbuild",
        "fileLocation": "relative",
        "pattern": [
          {
            "regexp": "^✘ \\[ERROR\\] (.+)$",
            "message": 1
          },
          {
            "regexp": "^\\s+(.+):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started$",
          "endsPattern": "^\\[watch\\] build finished$"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
