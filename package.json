{
  "name": "vscode-serial-port",
  "displayName": "Serial Port for VSCode",
  "icon": "media/icon.png",
  "description": "Full-featured serial port tool for VS Code: monitor, send/receive (hex or ASCII), RTS/DTR control, multiple ports in parallel, log-to-file, and reusable send templates. Works transparently from WSL windows against physical Windows ports.",
  "version": "0.0.2",
  "publisher": "haleywang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/haleywang0826/vscode-serial-port"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "serial",
    "serial port",
    "com port",
    "uart",
    "embedded",
    "wsl"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serialPort",
          "title": "Serial Port",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "serialPort": [
        {
          "type": "webview",
          "id": "serialPortExplorer",
          "name": ""
        }
      ]
    },
    "configuration": {
      "title": "Serial Port",
      "properties": {
        "serialPort.defaultBaudRate": {
          "type": "number",
          "default": 115200,
          "description": "Default baud rate used when a newly added port is opened."
        },
        "serialPort.defaultDataBits": {
          "type": "number",
          "enum": [
            5,
            6,
            7,
            8
          ],
          "default": 8,
          "description": "Default data bits used when a newly added port is opened."
        },
        "serialPort.defaultParity": {
          "type": "string",
          "enum": [
            "none",
            "even",
            "odd",
            "mark",
            "space"
          ],
          "default": "none",
          "description": "Default parity used when a newly added port is opened."
        },
        "serialPort.defaultStopBits": {
          "type": "number",
          "enum": [
            1,
            1.5,
            2
          ],
          "default": 1,
          "description": "Default stop bits used when a newly added port is opened."
        },
        "serialPort.defaultHexSend": {
          "type": "boolean",
          "default": false,
          "description": "Default Hex Send state used when a newly added port is opened."
        },
        "serialPort.defaultHexRecv": {
          "type": "boolean",
          "default": false,
          "description": "Default Hex Receive state used when a newly added port is opened."
        },
        "serialPort.saveLogAt": {
          "type": "string",
          "default": "${workspaceFolder}/serial_logs",
          "description": "Folder to write serial session log files to. The literal ${workspaceFolder} token is resolved to the first workspace folder at log-write time (falling back to the extension's global storage folder when no workspace is open); any other value is used as-is as an absolute path."
        },
        "serialPort.txColor": {
          "type": "string",
          "default": "#00cccc",
          "description": "Terminal color for transmitted (TX) bytes, as a CSS hex color."
        },
        "serialPort.rxColor": {
          "type": "string",
          "default": "#33cc33",
          "description": "Terminal color for received (RX) bytes, as a CSS hex color."
        },
        "serialPort.sendTemplates": {
          "type": "array",
          "default": [],
          "description": "Reusable send templates shown in the Send Templates panel section.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "format",
              "data"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "format": {
                "type": "string",
                "enum": [
                  "hex",
                  "ascii"
                ]
              },
              "data": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "problemMatchers": [
      {
        "name": "esbuild-watch",
        "source": "esbuild",
        "owner": "esbuild",
        "fileLocation": "relative",
        "pattern": [
          {
            "regexp": "^✘ \\[ERROR\\] (.+)$",
            "message": 1
          },
          {
            "regexp": "^\\s+(.+):(\\d+):(\\d+):$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[watch\\] build started$",
          "endsPattern": "^\\[watch\\] build finished$"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.134.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
